[Unit]
Description=Le Seizième Backend (FastAPI)
After=network.target postgresql.service

[Service]
Type=notify
User={{USER}}
Group={{GROUP}}
WorkingDirectory={{PROJECT_ROOT}}/backend
EnvironmentFile={{PROJECT_ROOT}}/backend/.env
Environment=PATH={{PROJECT_ROOT}}/backend/venv/bin
ExecStart={{PROJECT_ROOT}}/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
